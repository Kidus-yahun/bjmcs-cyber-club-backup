# =============================================================================
# BJMCS Cyber Club — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for production.
# NEVER commit your .env file containing actual secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/bjmcs_cyber_club?schema=public"

# -----------------------------------------------------------------------------
# Authentication Security
# -----------------------------------------------------------------------------
# Generate a secure 64-character random string for this in production
JWT_SECRET="replace-with-a-very-strong-random-secret"

# -----------------------------------------------------------------------------
# Email Configuration (Nodemailer)
# -----------------------------------------------------------------------------
# Optional in dev: If missing, emails print to console gracefully.
# Required in prod: For sending acceptance & activation emails.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"
SMTP_FROM="BJMCS Admissions <admissions@example.com>"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BJMCS Cyber Club"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
