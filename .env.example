# =============================================================================
# BGMCS Cyber Club — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values for production / Vercel.
# NEVER commit your .env file containing actual secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Neon Serverless PostgreSQL)
# -----------------------------------------------------------------------------
# 1. DATABASE_URL: Use Neon's pooled connection string (-pooler.region.neon.tech)
#    This connects via PgBouncer so Vercel serverless functions don't exhaust DB connections.
DATABASE_URL="postgresql://[user]:[password]@[endpoint-id]-pooler.[region].neon.tech/neondb?sslmode=require"

# 2. DIRECT_URL: Use Neon's direct connection string (without -pooler)
#    Used by Prisma CLI for migrations and schema pushes.
DIRECT_URL="postgresql://[user]:[password]@[endpoint-id].[region].neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication Security
# -----------------------------------------------------------------------------
# Generate a secure 64-character random string for this in production
JWT_SECRET="replace-with-a-very-strong-random-secret"

# -----------------------------------------------------------------------------
# Cloudflare R2 Object Storage (File Uploads & Submissions)
# -----------------------------------------------------------------------------
# Zero-egress fee S3-compatible storage for cadet tasks and project files.
# Found in: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="bgmcs-cyber-club"

# -----------------------------------------------------------------------------
# Email Configuration (Resend)
# -----------------------------------------------------------------------------
# Free tier gives 3,000/mo (max 100/day).
RESEND_API_KEY="re_your_api_key_here"

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="BGMCS Cyber Club"
NEXT_PUBLIC_APP_URL="https://bjmcs-cyber-club-backup-gqpwvgqwt.vercel.app"
